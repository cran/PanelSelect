\section{Optimizer methods}{
\tabular{ll}{
   Backend \tab Accepted methods \cr
   \code{"optim"} \tab \code{"BFGS"} (default), \code{"Nelder-Mead"}, \code{"CG"}, \code{"L-BFGS-B"}, \code{"SANN"} \cr
   \code{"maxLik"} \tab \code{"BFGS"} (default), \code{"NR"}/\code{"Newton-Raphson"}, \code{"BFGSR"}/\code{"BFGS-R"}, \code{"BHHH"}, \code{"CG"}/\code{"Conjugate-Gradient"}, \code{"NM"}/\code{"Nelder-Mead"}, \code{"SANN"} \cr
